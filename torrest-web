#!/usr/bin/env bash
# torrest-web — controller for the Torrest web panel (start|stop|status|help).
# serve.py serves the built app and proxies the Torrest API on the same
# origin. Configuration: ~/.config/torrest-web/config.
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/torrest-web/config"
PORT=""
ENGINE_HOST=""
ENGINE_PORT=""
if [[ -f "$CONFIG_FILE" ]]; then
    PORT="$(sed -n 's/^LISTEN_PORT="\{0,1\}\([0-9]*\)"\{0,1\}.*/\1/p' "$CONFIG_FILE" | head -1)"
    ENGINE_HOST="$(sed -n 's/^ENGINE_HOST="\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' "$CONFIG_FILE" | head -1)"
    ENGINE_PORT="$(sed -n 's/^ENGINE_PORT="\{0,1\}\([0-9]*\)"\{0,1\}.*/\1/p' "$CONFIG_FILE" | head -1)"
fi
PORT="${TORREST_WEB_PORT:-${PORT:-8135}}"
ENGINE="${ENGINE_HOST:-localhost}:${ENGINE_PORT:-61235}"

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
URL="http://127.0.0.1:${PORT}"

running() { curl -s --max-time 1 -o /dev/null "$URL"; }

usage() {
    cat <<EOF
torrest-web — web panel for a Torrest torrent engine

USAGE
  torrest-web start     start the local server (if needed) and open the panel
  torrest-web stop      stop the local server
  torrest-web status    show whether the panel and the engine respond
  torrest-web help      this help (also shown with no arguments)

  Panel:  $URL  (localhost only)
  Engine: $ENGINE  — edit $CONFIG_FILE to change it
EOF
}

case "${1:-help}" in
    start)
        if ! running; then
            nohup python3 "$DIR/serve.py" "$PORT" >/dev/null 2>&1 &
            for _ in $(seq 1 15); do
                running && break
                sleep 0.3
            done
        fi
        running || { echo "torrest-web: failed to start" >&2; exit 1; }
        brave-browser --new-tab "$URL" >/dev/null 2>&1 &
        echo "torrest-web: $URL"
        ;;
    stop)
        if fuser -k -TERM "${PORT}/tcp" >/dev/null 2>&1; then
            echo "torrest-web: stopped"
        else
            echo "torrest-web: not running"
        fi
        ;;
    status)
        if running; then
            echo "panel:  running at $URL"
            code="$(curl -s --max-time 3 -o /dev/null -w "%{http_code}" "$URL/torrents" || true)"
            if [[ "$code" == "200" ]]; then
                echo "engine: $ENGINE reachable"
            else
                echo "engine: $ENGINE NOT reachable (is the machine on?)"
            fi
        else
            echo "panel:  stopped ($URL)"
            echo "engine: $ENGINE (start the panel to check it)"
        fi
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "torrest-web: unknown command '${1}'" >&2
        usage >&2
        exit 1
        ;;
esac
